{
  "version": "2.13",
  "variables": {
    "wf-page-bg": {"type": "color", "value": "#F0F0F0"},
    "wf-surface": {"type": "color", "value": "#FFFFFF"},
    "wf-surface-alt": {"type": "color", "value": "#E8E8E8"},
    "wf-border": {"type": "color", "value": "#CCCCCC"},
    "wf-border-strong": {"type": "color", "value": "#999999"},
    "wf-text-primary": {"type": "color", "value": "#333333"},
    "wf-text-secondary": {"type": "color", "value": "#888888"},
    "wf-text-placeholder": {"type": "color", "value": "#AAAAAA"},
    "wf-accent": {"type": "color", "value": "#4A90D9"},
    "wf-state-empty": {"type": "color", "value": "#E8E8E8"},
    "wf-state-loading": {"type": "color", "value": "#D0D0D0"},
    "wf-state-error": {"type": "color", "value": "#D9534F"},
    "wf-state-success": {"type": "color", "value": "#5CB85C"},
    "wf-space-xs": {"type": "number", "value": 4},
    "wf-space-sm": {"type": "number", "value": 8},
    "wf-space-md": {"type": "number", "value": 16},
    "wf-space-lg": {"type": "number", "value": 24},
    "wf-space-xl": {"type": "number", "value": 32},
    "wf-radius": {"type": "number", "value": 4},
    "wf-radius-lg": {"type": "number", "value": 8},
    "wf-font-family": {"type": "string", "value": "Inter"},
    "wf-text-xs": {"type": "number", "value": 10},
    "wf-text-sm": {"type": "number", "value": 12},
    "wf-text-base": {"type": "number", "value": 14},
    "wf-text-lg": {"type": "number", "value": 18},
    "wf-text-xl": {"type": "number", "value": 24},
    "wf-text-2xl": {"type": "number", "value": 32}
  },
  "children": [
    {
      "id": "wf-page-shell",
      "type": "frame",
      "name": "Page Shell",
      "reusable": true,
      "x": 0, "y": 0,
      "width": 1440,
      "height": 900,
      "layout": "vertical",
      "fill": "$wf-page-bg",
      "children": [
        {
          "id": "header-slot",
          "type": "frame",
          "name": "Header Slot",
          "width": "fill_container",
          "height": "fit_content",
          "layout": "horizontal",
          "alignItems": "center",
          "justifyContent": "space_between",
          "fill": "$wf-surface",
          "padding": ["$wf-space-md", "$wf-space-lg"]
        },
        {
          "id": "body-slot",
          "type": "frame",
          "name": "Body Slot",
          "width": "fill_container",
          "height": "fill_container",
          "layout": "horizontal"
        },
        {
          "id": "footer-slot",
          "type": "frame",
          "name": "Footer Slot",
          "width": "fill_container",
          "height": "fit_content",
          "layout": "horizontal",
          "alignItems": "center",
          "fill": "$wf-surface",
          "padding": ["$wf-space-sm", "$wf-space-lg"]
        }
      ]
    },
    {
      "id": "wf-header",
      "type": "frame",
      "name": "Header Bar",
      "reusable": true,
      "x": 1550, "y": 0,
      "width": "fill_container(800)",
      "height": "fit_content",
      "layout": "horizontal",
      "alignItems": "center",
      "justifyContent": "space_between",
      "fill": "$wf-surface",
      "children": [
        {
          "id": "header-logo",
          "type": "frame",
          "name": "Logo",
          "width": 120, "height": 32,
          "fill": "$wf-surface-alt",
          "cornerRadius": "$wf-radius"
        },
        {
          "id": "header-nav",
          "type": "frame",
          "name": "Nav Items",
          "layout": "horizontal",
          "gap": "$wf-space-lg",
          "alignItems": "center"
        },
        {
          "id": "header-actions",
          "type": "frame",
          "name": "Actions",
          "layout": "horizontal",
          "gap": "$wf-space-sm",
          "alignItems": "center"
        }
      ]
    },
    {
      "id": "wf-sidebar",
      "type": "frame",
      "name": "Sidebar",
      "reusable": true,
      "x": 1550, "y": 100,
      "width": 240,
      "height": "fill_container(700)",
      "layout": "vertical",
      "gap": "$wf-space-xs",
      "fill": "$wf-surface",
      "padding": "$wf-space-md",
      "children": [
        {
          "id": "sidebar-section-label",
          "type": "text",
          "content": "NAVIGATION",
          "fontFamily": "$wf-font-family",
          "fontSize": "$wf-text-xs",
          "fontWeight": "700",
          "fill": "$wf-text-secondary",
          "height": 24
        }
      ]
    },
    {
      "id": "wf-content-area",
      "type": "frame",
      "name": "Content Area",
      "reusable": true,
      "x": 1850, "y": 100,
      "width": "fill_container(1200)",
      "height": "fill_container(700)",
      "layout": "vertical",
      "gap": "$wf-space-lg",
      "fill": "$wf-page-bg",
      "padding": "$wf-space-lg",
      "children": [
        {
          "id": "content-title",
          "type": "text",
          "content": "Page Title",
          "fontFamily": "$wf-font-family",
          "fontSize": "$wf-text-xl",
          "fontWeight": "700",
          "fill": "$wf-text-primary",
          "height": 32
        },
        {
          "id": "content-slot",
          "type": "frame",
          "name": "Content Slot",
          "width": "fill_container",
          "height": "fit_content",
          "layout": "vertical",
          "gap": "$wf-space-lg"
        }
      ]
    },
    {
      "id": "wf-card",
      "type": "frame",
      "name": "Card",
      "reusable": true,
      "x": 1550, "y": 250,
      "width": "fill_container(400)",
      "height": "fit_content",
      "layout": "vertical",
      "gap": "$wf-space-md",
      "fill": "$wf-surface",
      "cornerRadius": "$wf-radius-lg",
      "stroke": "$wf-border",
      "strokeWidth": 1,
      "padding": "$wf-space-lg",
      "children": [
        {
          "id": "card-title",
          "type": "text",
          "content": "Card Title",
          "fontFamily": "$wf-font-family",
          "fontSize": "$wf-text-lg",
          "fontWeight": "600",
          "fill": "$wf-text-primary"
        },
        {
          "id": "card-body",
          "type": "frame",
          "name": "Card Body",
          "width": "fill_container",
          "height": "fit_content",
          "layout": "vertical",
          "gap": "$wf-space-sm"
        }
      ]
    },
    {
      "id": "wf-form-field",
      "type": "frame",
      "name": "Form Field",
      "reusable": true,
      "x": 1550, "y": 400,
      "width": 300,
      "height": "fit_content",
      "layout": "vertical",
      "gap": "$wf-space-xs",
      "children": [
        {
          "id": "field-label",
          "type": "text",
          "content": "Label",
          "fontFamily": "$wf-font-family",
          "fontSize": "$wf-text-sm",
          "fontWeight": "500",
          "fill": "$wf-text-primary"
        },
        {
          "id": "field-input",
          "type": "rectangle",
          "width": "fill_container",
          "height": 36,
          "fill": "$wf-surface",
          "stroke": "$wf-border",
          "strokeWidth": 1,
          "cornerRadius": "$wf-radius"
        }
      ]
    },
    {
      "id": "wf-button",
      "type": "frame",
      "name": "Button",
      "reusable": true,
      "x": 1550, "y": 500,
      "width": "fit_content",
      "height": 36,
      "layout": "horizontal",
      "alignItems": "center",
      "justifyContent": "center",
      "fill": "$wf-accent",
      "cornerRadius": 9999,
      "padding": ["$wf-space-sm", "$wf-space-lg"],
      "children": [
        {
          "id": "button-label",
          "type": "text",
          "content": "Button",
          "fontFamily": "$wf-font-family",
          "fontSize": "$wf-text-sm",
          "fontWeight": "600",
          "fill": "$wf-surface"
        }
      ]
    },
    {
      "id": "wf-placeholder-box",
      "type": "frame",
      "name": "Placeholder Box",
      "reusable": true,
      "x": 1550, "y": 570,
      "width": 300,
      "height": 80,
      "layout": "vertical",
      "alignItems": "center",
      "justifyContent": "center",
      "fill": "$wf-surface-alt",
      "cornerRadius": "$wf-radius",
      "stroke": "$wf-border",
      "strokeWidth": 1,
      "children": [
        {
          "id": "placeholder-label",
          "type": "text",
          "content": "Placeholder",
          "fontFamily": "$wf-font-family",
          "fontSize": "$wf-text-sm",
          "fill": "$wf-text-placeholder"
        }
      ]
    },
    {
      "id": "wf-nav-item",
      "type": "frame",
      "name": "Nav Item",
      "reusable": true,
      "x": 1550, "y": 670,
      "width": "fit_content",
      "height": "fit_content",
      "layout": "horizontal",
      "gap": "$wf-space-sm",
      "alignItems": "center",
      "padding": ["$wf-space-xs", "$wf-space-sm"],
      "children": [
        {
          "id": "nav-icon",
          "type": "rectangle",
          "width": 16, "height": 16,
          "fill": "$wf-text-secondary",
          "cornerRadius": 2
        },
        {
          "id": "nav-label",
          "type": "text",
          "content": "Nav Item",
          "fontFamily": "$wf-font-family",
          "fontSize": "$wf-text-sm",
          "fill": "$wf-text-primary"
        }
      ]
    },
    {
      "id": "wf-state-badge",
      "type": "frame",
      "name": "State Badge",
      "reusable": true,
      "x": 1550, "y": 730,
      "width": "fit_content",
      "height": "fit_content",
      "layout": "horizontal",
      "alignItems": "center",
      "justifyContent": "center",
      "fill": "$wf-state-empty",
      "cornerRadius": 9999,
      "padding": ["$wf-space-xs", "$wf-space-sm"],
      "children": [
        {
          "id": "badge-label",
          "type": "text",
          "content": "empty",
          "fontFamily": "$wf-font-family",
          "fontSize": "$wf-text-xs",
          "fontWeight": "500",
          "fill": "$wf-text-secondary"
        }
      ]
    },
    {
      "id": "wf-table",
      "type": "frame",
      "name": "Table",
      "reusable": true,
      "x": 2000, "y": 250,
      "width": 500,
      "height": "fit_content",
      "layout": "vertical",
      "fill": "$wf-surface",
      "stroke": "$wf-border",
      "strokeWidth": 1,
      "cornerRadius": "$wf-radius",
      "children": [
        {
          "id": "table-header",
          "type": "frame",
          "name": "Table Header",
          "width": "fill_container",
          "height": 40,
          "layout": "horizontal",
          "alignItems": "center",
          "fill": "$wf-surface-alt",
          "padding": "$wf-space-sm",
          "children": [
            {
              "id": "th-col1",
              "type": "text",
              "content": "Column 1",
              "fontFamily": "$wf-font-family",
              "fontSize": "$wf-text-sm",
              "fontWeight": "600",
              "fill": "$wf-text-primary",
              "width": "fill_container"
            },
            {
              "id": "th-col2",
              "type": "text",
              "content": "Column 2",
              "fontFamily": "$wf-font-family",
              "fontSize": "$wf-text-sm",
              "fontWeight": "600",
              "fill": "$wf-text-primary",
              "width": "fill_container"
            }
          ]
        }
      ]
    },
    {
      "id": "wf-table-row",
      "type": "frame",
      "name": "Table Row",
      "reusable": true,
      "x": 2000, "y": 320,
      "width": 500,
      "height": 36,
      "layout": "horizontal",
      "alignItems": "center",
      "padding": "$wf-space-sm",
      "stroke": "$wf-border",
      "strokeWidth": {"top": 1},
      "children": [
        {
          "id": "td-col1",
          "type": "text",
          "content": "Cell data",
          "fontFamily": "$wf-font-family",
          "fontSize": "$wf-text-sm",
          "fill": "$wf-text-primary",
          "width": "fill_container"
        },
        {
          "id": "td-col2",
          "type": "text",
          "content": "Cell data",
          "fontFamily": "$wf-font-family",
          "fontSize": "$wf-text-sm",
          "fill": "$wf-text-primary",
          "width": "fill_container"
        }
      ]
    },
    {
      "id": "wf-footer",
      "type": "frame",
      "name": "Footer Bar",
      "reusable": true,
      "x": 1550, "y": 850,
      "width": "fill_container(800)",
      "height": "fit_content",
      "layout": "horizontal",
      "alignItems": "center",
      "justifyContent": "space_between",
      "fill": "$wf-surface",
      "padding": ["$wf-space-sm", "$wf-space-lg"],
      "children": [
        {
          "id": "footer-text",
          "type": "text",
          "content": "Footer text",
          "fontFamily": "$wf-font-family",
          "fontSize": "$wf-text-xs",
          "fill": "$wf-text-secondary"
        }
      ]
    },
    {
      "id": "dashboard-page",
      "type": "ref",
      "ref": "wf-page-shell",
      "name": "Dashboard Page",
      "x": 0, "y": 1100,
      "width": 1440, "height": 900,
      "descendants": {
        "header-slot": {
          "children": [
            {
              "id": "dash-header",
              "type": "ref",
              "ref": "wf-header",
              "descendants": {
                "header-nav": {
                  "children": [
                    {
                      "id": "nav-dashboard",
                      "type": "ref",
                      "ref": "wf-nav-item",
                      "descendants": {"nav-label": {"content": "Dashboard"}}
                    },
                    {
                      "id": "nav-tasks",
                      "type": "ref",
                      "ref": "wf-nav-item",
                      "descendants": {"nav-label": {"content": "Tasks"}}
                    },
                    {
                      "id": "nav-settings",
                      "type": "ref",
                      "ref": "wf-nav-item",
                      "descendants": {"nav-label": {"content": "Settings"}}
                    }
                  ]
                },
                "header-actions": {
                  "children": [
                    {
                      "id": "header-create-btn",
                      "type": "ref",
                      "ref": "wf-button",
                      "descendants": {"button-label": {"content": "+ New Task"}}
                    }
                  ]
                }
              }
            }
          ]
        },
        "body-slot": {
          "children": [
            {
              "id": "dash-sidebar",
              "type": "ref",
              "ref": "wf-sidebar",
              "width": 240,
              "descendants": {
                "sidebar-section-label": {"content": "MENU"}
              }
            },
            {
              "id": "dash-content",
              "type": "ref",
              "ref": "wf-content-area",
              "descendants": {
                "content-title": {"content": "Task Dashboard"},
                "content-slot": {
                  "children": [
                    {
                      "id": "stats-card",
                      "type": "ref",
                      "ref": "wf-card",
                      "descendants": {
                        "card-title": {"content": "Task Statistics"},
                        "card-body": {
                          "children": [
                            {
                              "id": "stat-chart",
                              "type": "ref",
                              "ref": "wf-placeholder-box",
                              "width": "fill_container",
                              "height": 120,
                              "descendants": {"placeholder-label": {"content": "Progress Chart"}}
                            }
                          ]
                        }
                      }
                    },
                    {
                      "id": "task-list-card",
                      "type": "ref",
                      "ref": "wf-card",
                      "descendants": {
                        "card-title": {"content": "Assigned Tasks"},
                        "card-body": {
                          "children": [
                            {
                              "id": "task-table",
                              "type": "ref",
                              "ref": "wf-table",
                              "width": "fill_container",
                              "descendants": {
                                "th-col1": {"content": "Task Name"},
                                "th-col2": {"content": "Priority"}
                              }
                            },
                            {
                              "id": "row-1",
                              "type": "ref",
                              "ref": "wf-table-row",
                              "width": "fill_container",
                              "descendants": {
                                "td-col1": {"content": "Fix login bug"},
                                "td-col2": {"content": "High"}
                              }
                            },
                            {
                              "id": "row-2",
                              "type": "ref",
                              "ref": "wf-table-row",
                              "width": "fill_container",
                              "descendants": {
                                "td-col1": {"content": "Add export feature"},
                                "td-col2": {"content": "Medium"}
                              }
                            },
                            {
                              "id": "row-3",
                              "type": "ref",
                              "ref": "wf-table-row",
                              "width": "fill_container",
                              "descendants": {
                                "td-col1": {"content": "Update documentation"},
                                "td-col2": {"content": "Low"}
                              }
                            }
                          ]
                        }
                      }
                    },
                    {
                      "id": "quick-actions-card",
                      "type": "ref",
                      "ref": "wf-card",
                      "descendants": {
                        "card-title": {"content": "Quick Actions"},
                        "card-body": {
                          "children": [
                            {
                              "id": "action-filter",
                              "type": "ref",
                              "ref": "wf-button",
                              "descendants": {"button-label": {"content": "Filter Tasks"}}
                            },
                            {
                              "id": "action-export",
                              "type": "ref",
                              "ref": "wf-button",
                              "descendants": {"button-label": {"content": "Export CSV"}}
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        "footer-slot": {
          "children": [
            {
              "id": "dash-footer",
              "type": "ref",
              "ref": "wf-footer",
              "descendants": {
                "footer-text": {"content": "TaskFlow v1.0 — Wireframe Preview"}
              }
            }
          ]
        }
      }
    },
    {
      "id": "settings-page",
      "type": "ref",
      "ref": "wf-page-shell",
      "name": "Settings Page",
      "x": 1600, "y": 1100,
      "width": 1440, "height": 900,
      "descendants": {
        "header-slot": {
          "children": [
            {
              "id": "settings-header",
              "type": "ref",
              "ref": "wf-header",
              "descendants": {
                "header-nav": {
                  "children": [
                    {
                      "id": "settings-nav-dashboard",
                      "type": "ref",
                      "ref": "wf-nav-item",
                      "descendants": {"nav-label": {"content": "Dashboard"}}
                    },
                    {
                      "id": "settings-nav-tasks",
                      "type": "ref",
                      "ref": "wf-nav-item",
                      "descendants": {"nav-label": {"content": "Tasks"}}
                    },
                    {
                      "id": "settings-nav-settings",
                      "type": "ref",
                      "ref": "wf-nav-item",
                      "descendants": {"nav-label": {"content": "Settings"}}
                    }
                  ]
                }
              }
            }
          ]
        },
        "body-slot": {
          "children": [
            {
              "id": "settings-sidebar",
              "type": "ref",
              "ref": "wf-sidebar",
              "width": 240,
              "descendants": {
                "sidebar-section-label": {"content": "SETTINGS"}
              }
            },
            {
              "id": "settings-content",
              "type": "ref",
              "ref": "wf-content-area",
              "descendants": {
                "content-title": {"content": "User Settings"},
                "content-slot": {
                  "children": [
                    {
                      "id": "profile-card",
                      "type": "ref",
                      "ref": "wf-card",
                      "descendants": {
                        "card-title": {"content": "Profile Information"},
                        "card-body": {
                          "children": [
                            {
                              "id": "field-name",
                              "type": "ref",
                              "ref": "wf-form-field",
                              "width": "fill_container",
                              "descendants": {"field-label": {"content": "Full Name"}}
                            },
                            {
                              "id": "field-email",
                              "type": "ref",
                              "ref": "wf-form-field",
                              "width": "fill_container",
                              "descendants": {"field-label": {"content": "Email Address"}}
                            },
                            {
                              "id": "field-role",
                              "type": "ref",
                              "ref": "wf-form-field",
                              "width": "fill_container",
                              "descendants": {"field-label": {"content": "Role"}}
                            },
                            {
                              "id": "save-btn",
                              "type": "ref",
                              "ref": "wf-button",
                              "descendants": {"button-label": {"content": "Save Changes"}}
                            }
                          ]
                        }
                      }
                    },
                    {
                      "id": "notifications-card",
                      "type": "ref",
                      "ref": "wf-card",
                      "descendants": {
                        "card-title": {"content": "Notification Preferences"},
                        "card-body": {
                          "children": [
                            {
                              "id": "notif-placeholder",
                              "type": "ref",
                              "ref": "wf-placeholder-box",
                              "width": "fill_container",
                              "height": 100,
                              "descendants": {"placeholder-label": {"content": "Toggle switches for email, push, and SMS notifications"}}
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        "footer-slot": {
          "children": [
            {
              "id": "settings-footer",
              "type": "ref",
              "ref": "wf-footer",
              "descendants": {
                "footer-text": {"content": "TaskFlow v1.0 — Settings Wireframe"}
              }
            }
          ]
        }
      }
    }
  ]
}
